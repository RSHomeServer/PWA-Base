{
  "name": "@platform/catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Registered site catalog — the only package that depends on site implementations",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./loaders": {
      "types": "./src/loaders.ts",
      "import": "./src/loaders.ts",
      "default": "./src/loaders.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@platform/site-components": "workspace:*",
    "@platform/site-dashboard": "workspace:*",
    "@platform/site-docs": "workspace:*",
    "@platform/site-hello": "workspace:*",
    "@platform/site-registry": "workspace:*"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
