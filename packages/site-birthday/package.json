{
  "name": "@platform/site-birthday",
  "version": "0.0.0",
  "private": true,
  "description": "Premium interactive 21st birthday keepsake experience",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "pack:sync": "node ../../scripts/sync-birthday-pack.mjs"
  },
  "dependencies": {
    "@platform/controls": "workspace:*",
    "@platform/runtime": "workspace:*",
    "@platform/site-memories": "workspace:*",
    "@platform/site-registry": "workspace:*",
    "@platform/ui": "workspace:*",
    "react-router-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
