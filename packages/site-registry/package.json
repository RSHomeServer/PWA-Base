{
  "name": "@platform/site-registry",
  "version": "0.0.0",
  "private": true,
  "description": "Site registration contract for the platform host",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "import": "./src/contract.ts",
      "default": "./src/contract.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "typescript": "catalog:"
  }
}
