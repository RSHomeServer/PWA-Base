{
  "name": "@platform/site-components",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive showcase for Songara Studio design system components",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:catalog": "tsx scripts/generate-components-catalog.mts"
  },
  "dependencies": {
    "@platform/controls": "workspace:*",
    "@platform/site-registry": "workspace:*",
    "@platform/ui": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/react": "catalog:",
    "tsx": "^4.20.0",
    "typescript": "catalog:"
  }
}
