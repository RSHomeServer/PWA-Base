{
  "name": "@platform/site-hello",
  "version": "0.0.0",
  "private": true,
  "description": "Hello application site package",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "content"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:sync": "node ../../scripts/sync-content-pack.mjs hello hello-base"
  },
  "dependencies": {
    "@platform/runtime": "workspace:*",
    "@platform/site-registry": "workspace:*",
    "@platform/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
