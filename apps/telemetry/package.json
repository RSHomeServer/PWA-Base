{
  "name": "@platform/telemetry",
  "version": "0.2.6",
  "private": true,
  "description": "AI Development Dashboard telemetry service — Cursor hook ingest, SQLite, WebSocket",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "telemetry-server": "./src/cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "capture": "tsx src/artifacts/capture-cli.ts"
  },
  "dependencies": {
    "@platform/completion-report": "workspace:*",
    "tsx": "^4.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
