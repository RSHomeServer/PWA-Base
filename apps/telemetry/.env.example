# =============================================================================
# Telemetry SERVER — Docker Compose is the canonical runtime.
# These values are set in docker-compose.yml for the `telemetry` service.
# Local `pnpm --filter @platform/telemetry start` is for unit/integration tests only —
# do NOT run it alongside Docker (EADDRINUSE + split SQLite).
# =============================================================================

TELEMETRY_HOST=0.0.0.0
TELEMETRY_PORT=4310

# Docker volume path (compose sets this). Host-only test runs may use ./data/...
TELEMETRY_DB=/data/telemetry.sqlite

# TELEMETRY_ENDPOINT is NOT used on the server — that belongs on Cursor clients.

# Lifecycle supervisor (optional — defaults shown)
# TELEMETRY_IDLE_TIMEOUT_MS=1800000
# TELEMETRY_IDLE_SOFT_MS=900000
# TELEMETRY_SUPERVISOR_INTERVAL_MS=30000
# TELEMETRY_TASK_COMPLETION_GRACE_MS=60000
