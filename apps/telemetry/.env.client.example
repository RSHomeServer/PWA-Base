# =============================================================================
# Cursor CLIENT — used by scripts/telemetry-hook.sh
# Export in the environment Cursor inherits for hook commands.
#
# Canonical backend is the Docker telemetry service (one SQLite volume).
# Both localhost Vite and apps.songara.uk talk to that same container.
# =============================================================================

# Same machine as Docker host (port 4310 published by compose):
TELEMETRY_ENDPOINT=http://127.0.0.1:4310

# Cursor on a VM / laptop → Docker host LAN IP:
# TELEMETRY_ENDPOINT=http://192.168.1.150:4310

# Or via Traefik (identical SQLite as :4310):
# TELEMETRY_ENDPOINT=https://apps.songara.uk/telemetry

# Optional: full hooks URL also accepted
# TELEMETRY_ENDPOINT=http://127.0.0.1:4310/hooks
