{
  "name": "@platform/host",
  "version": "0.0.0",
  "private": true,
  "description": "Platform host application (Vite + React + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@platform/animation": "workspace:*",
    "@platform/catalog": "workspace:*",
    "@platform/runtime": "workspace:*",
    "@platform/site-registry": "workspace:*",
    "@platform/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:"
  }
}
