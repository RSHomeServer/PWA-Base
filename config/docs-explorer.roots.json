{
  "baseDir": ".",
  "roots": [
    {
      "id": "repo",
      "title": "Website_Hosting/",
      "description": "Repository root — Markdown files and documentation folders",
      "path": ".",
      "skipDirs": [
        "apps",
        "node_modules",
        "e2e",
        "docker",
        "scripts",
        "test-results",
        "playwright-report",
        "coverage",
        "dist",
        "config",
        ".cursor",
        ".pnpm-store"
      ]
    },
    {
      "id": "docs",
      "title": "docs/",
      "description": "Documentation tree (architecture, guides, milestones, ADRs, …)",
      "path": "docs"
    },
    {
      "id": "packages",
      "title": "packages/",
      "description": "Package READMEs and Markdown under packages/",
      "path": "packages",
      "skipDirs": ["node_modules", "dist", "coverage"]
    }
  ]
}
