{
  "name": "@songara/pwa-base",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Songara PWA foundation — site contract, runtime, UI primitives, and packaging helpers",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "import": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./ui": {
      "types": "./packages/ui/src/index.ts",
      "import": "./packages/ui/src/index.ts",
      "default": "./packages/ui/src/index.ts"
    },
    "./ui/theme": {
      "types": "./packages/ui/src/theme/index.ts",
      "import": "./packages/ui/src/theme/index.ts",
      "default": "./packages/ui/src/theme/index.ts"
    },
    "./ui/tokens.css": "./packages/ui/src/tokens/tokens.css",
    "./config/tsconfig.base.json": "./packages/config/tsconfig.base.json",
    "./config/tsconfig.react.json": "./packages/config/tsconfig.react.json",
    "./config/tsconfig.node.json": "./packages/config/tsconfig.node.json",
    "./config/vite-app-version": {
      "types": "./packages/config/vite-app-version.d.ts",
      "default": "./packages/config/vite-app-version.js"
    },
    "./completion-report": {
      "types": "./packages/completion-report/src/index.ts",
      "import": "./packages/completion-report/src/index.ts",
      "default": "./packages/completion-report/src/index.ts"
    },
    "./controls": {
      "types": "./packages/controls/src/index.ts",
      "import": "./packages/controls/src/index.ts",
      "default": "./packages/controls/src/index.ts"
    },
    "./math": {
      "types": "./packages/math/src/index.ts",
      "import": "./packages/math/src/index.ts",
      "default": "./packages/math/src/index.ts"
    },
    "./physics": {
      "types": "./packages/physics/src/index.ts",
      "import": "./packages/physics/src/index.ts",
      "default": "./packages/physics/src/index.ts"
    },
    "./export": {
      "types": "./packages/export/src/index.ts",
      "import": "./packages/export/src/index.ts",
      "default": "./packages/export/src/index.ts"
    },
    "./markdown": {
      "types": "./packages/markdown/src/index.ts",
      "import": "./packages/markdown/src/index.ts",
      "default": "./packages/markdown/src/index.ts"
    },
    "./markdown/styles.css": "./packages/markdown/src/markdown.css",
    "./animation": {
      "types": "./packages/animation/src/index.ts",
      "import": "./packages/animation/src/index.ts",
      "default": "./packages/animation/src/index.ts"
    },
    "./browser": {
      "types": "./packages/browser/src/index.ts",
      "import": "./packages/browser/src/index.ts",
      "default": "./packages/browser/src/index.ts"
    },
    "./audio": {
      "types": "./packages/audio/src/index.ts",
      "import": "./packages/audio/src/index.ts",
      "default": "./packages/audio/src/index.ts"
    },
    "./render": {
      "types": "./packages/render/src/index.ts",
      "import": "./packages/render/src/index.ts",
      "default": "./packages/render/src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "packages/animation/src",
    "packages/browser/src",
    "packages/audio/src",
    "packages/render/src",
    "packages/completion-report/src",
    "packages/controls/src",
    "packages/math/src",
    "packages/physics/src",
    "packages/export/src",
    "packages/markdown/src",
    "packages/runtime/src",
    "packages/site-registry/src",
    "packages/ui/src",
    "packages/config/tsconfig.base.json",
    "packages/config/tsconfig.react.json",
    "packages/config/tsconfig.node.json",
    "packages/config/vite-app-version.js",
    "packages/config/vite-app-version.d.ts",
    "packages/config/eslint.config.js",
    "packages/config/prettier.config.js",
    "README.md",
    "docs/guides/consuming-pwa-base.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs start",
    "stop": "node scripts/dev-server.mjs stop",
    "dev:host": "pnpm --filter @platform/host dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @platform/catalog --filter @platform/host --filter @platform/math --filter @platform/physics --filter @platform/export --filter @platform/controls --filter @platform/markdown --filter @platform/animation --filter @platform/audio --filter @platform/browser --filter @platform/render --filter @platform/ui --filter @platform/runtime --filter @platform/completion-report --filter @platform/telemetry test:unit",
    "test:e2e": "playwright test",
    "telemetry:up": "docker compose up -d telemetry",
    "telemetry:down": "docker compose stop telemetry",
    "telemetry:logs": "docker compose logs -f telemetry",
    "telemetry:rebuild": "docker compose up -d --build telemetry",
    "capture:artifacts": "node scripts/capture-artifacts.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "content-pack:sync": "node scripts/sync-content-pack.mjs",
    "new-app": "node scripts/new-app.mjs",
    "ensure-sibling-file-deps": "node scripts/ensure-sibling-file-deps.mjs"
  },
  "dependencies": {
    "workbox-window": "^7.4.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@platform/config": "workspace:*",
    "@playwright/test": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
