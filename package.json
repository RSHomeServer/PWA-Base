{
  "name": "@songara/pwa-base",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Songara PWA foundation — site contract, runtime, UI primitives, and packaging helpers",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "import": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./ui": {
      "types": "./packages/ui/src/index.ts",
      "import": "./packages/ui/src/index.ts",
      "default": "./packages/ui/src/index.ts"
    },
    "./ui/theme": {
      "types": "./packages/ui/src/theme/index.ts",
      "import": "./packages/ui/src/theme/index.ts",
      "default": "./packages/ui/src/theme/index.ts"
    },
    "./ui/tokens.css": "./packages/ui/src/tokens/tokens.css",
    "./config/tsconfig.base.json": "./packages/config/tsconfig.base.json",
    "./config/tsconfig.react.json": "./packages/config/tsconfig.react.json",
    "./config/tsconfig.node.json": "./packages/config/tsconfig.node.json",
    "./config/vite-app-version": {
      "types": "./packages/config/vite-app-version.d.ts",
      "default": "./packages/config/vite-app-version.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "packages/runtime/src",
    "packages/site-registry/src",
    "packages/ui/src",
    "packages/config/tsconfig.base.json",
    "packages/config/tsconfig.react.json",
    "packages/config/tsconfig.node.json",
    "packages/config/vite-app-version.js",
    "packages/config/vite-app-version.d.ts",
    "packages/config/eslint.config.js",
    "packages/config/prettier.config.js",
    "README.md",
    "docs/guides/consuming-pwa-base.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs start",
    "stop": "node scripts/dev-server.mjs stop",
    "dev:host": "pnpm --filter @platform/host dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @platform/catalog --filter @platform/host --filter @platform/math --filter @platform/physics --filter @platform/runtime --filter @platform/experiences --filter @platform/site-viz --filter @platform/telemetry --filter @platform/docs-api test:unit",
    "test:e2e": "playwright test",
    "telemetry:up": "docker compose up -d telemetry",
    "telemetry:down": "docker compose stop telemetry",
    "telemetry:logs": "docker compose logs -f telemetry",
    "telemetry:rebuild": "docker compose up -d --build telemetry",
    "docs-api:up": "docker compose up -d docs-api",
    "docs-api:down": "docker compose stop docs-api",
    "docs-api:logs": "docker compose logs -f docs-api",
    "docs-api:rebuild": "docker compose up -d --build docs-api",
    "capture:artifacts": "pnpm --filter @platform/telemetry capture",
    "version:bump": "node scripts/bump-version.mjs",
    "content-pack:sync": "node scripts/sync-content-pack.mjs",
    "birthday:pack": "node scripts/sync-content-pack.mjs birthday birthday-base",
    "new-app": "node scripts/new-app.mjs",
    "ensure-sibling-file-deps": "node scripts/ensure-sibling-file-deps.mjs",
    "capture:birthday-previews": "node scripts/capture-birthday-previews.mjs"
  },
  "dependencies": {
    "workbox-window": "^7.4.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@platform/config": "workspace:*",
    "@playwright/test": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
